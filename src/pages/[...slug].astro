---
import Layout from '../layouts/Layout.astro';
import {pages,findPage,href,vowels,phrases,type Page} from '../data/content';
import {Image} from 'astro:assets';
import portrait from '../assets/neelam-portrait.jpg';
import TimePlanner from '../components/TimePlanner.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ResourceCards from '../components/ResourceCards.astro';
export function getStaticPaths(){return pages.map(page=>({params:{slug:page.slug},props:{page}}));}
interface Props {page:Page}
const {page}=Astro.props;
const parent=page.parent?findPage(page.parent):undefined;
const crumbs=[...(parent?[{name:parent.heading,path:href(parent.slug)}]:[]),{name:page.heading,path:href(page.slug)}];
const enquiry='/contact/'+(page.city?`?city=${encodeURIComponent(page.city)}`:'');
const isResource=page.slug.startsWith('resources/');
---
<Layout title={page.title} description={page.description} locale={page.locale} crumbs={crumbs} service={['service','city','country'].includes(page.kind??'')}>
<div class="shell"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c,i)=><><span aria-hidden="true">/</span>{i===crumbs.length-1?<span aria-current="page">{c.name}</span>:<a href={c.path}>{c.name}</a>}</>)}</nav>
<header class="page-hero"><p class="eyebrow">{page.eyebrow}</p><h1>{page.heading}</h1><p class="lead">{page.lead}</p>{['service','city','country'].includes(page.kind??'')&&<div class="actions"><a class="button" href={enquiry}>Discuss your learning goals <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a><a class="text-link" href={'/time-zones/'+(page.zone?`?zone=${encodeURIComponent(page.zone)}`:'')}>Check a lesson time</a></div>}</header>
{page.kind==='resources'&&<div class="mb-12"><ResourceCards/></div>}
<div class="reading-layout"><article>
{page.kind==='about'&&<Image class="profile-image" src={portrait} alt="Neelam smiling" width={600} height={800} format="webp"/>}
{page.sections.map((section,i)=><section class="prose-section" aria-labelledby={`section-${i}`}><h2 id={`section-${i}`}>{section.title}</h2><p>{section.body}</p></section>)}
{page.cities&&<section aria-labelledby="cities"><h2 id="cities">Find your city</h2><p>Explore a city guide or ask about online lessons in your time zone.</p><div class="city-grid">{page.cities.map(city=><article class="city-item" id={city.anchor}><h3>{city.name}</h3><p>{city.note}</p>{city.path?<a href={href(city.path)}>Read the {city.name} guide <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a>:<a href={`/contact/?city=${encodeURIComponent(city.name)}`}>Enquire from {city.name} <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a>}</article>)}</div></section>}
{page.kind==='alphabet'&&<section aria-labelledby="alphabet"><h2 id="alphabet">A letter reference to explore</h2><h3>Independent vowels</h3><p lang="hi" class="alphabet-line">अ आ इ ई उ ऊ ऋ ए ऐ ओ औ</p><h3>Consonant groups</h3>{[['Velar','क ख ग घ ङ'],['Palatal','च छ ज झ ञ'],['Retroflex','ट ठ ड ढ ण'],['Dental','त थ द ध न'],['Labial','प फ ब भ म'],['Other consonants','य र ल व श ष स ह']].map(([label,letters])=><div class="alphabet-row"><span>{label}</span><p lang="hi" class="alphabet-line">{letters}</p></div>)}<p class="form-hint">Use the group names as a guide, not a pronunciation substitute. Practise sounds with a teacher.</p><a class="text-link" href="/resources/hindi-vowels/">Start smaller with the vowel practice sheet <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a></section>}
{page.kind==='vowels'&&<section aria-labelledby="vowels"><h2 id="vowels">Ten vowels to begin with</h2><div class="vowel-grid">{vowels.map(([letter,sound])=><div class="vowel-card"><span lang="hi">{letter}</span><small>{sound}</small></div>)}</div><a class="button button-outline" href="/resources/hindi-vowel-practice.pdf" download>Download the practice sheet ↓</a><p class="form-hint" style="margin-top:12px">A4 PDF · Hindi letters and space to practise · Not a complete alphabet</p></section>}
{page.kind==='phrases'&&<table class="phrase-table"><caption class="text-left font-semibold">Five phrases to try together</caption><thead><tr><th scope="col">Hindi</th><th scope="col">Say it</th><th scope="col">Meaning</th></tr></thead><tbody>{phrases.map(([hi,roman,en])=><tr><td lang="hi">{hi}</td><td>{roman}</td><td>{en}</td></tr>)}</tbody></table>}
{page.kind==='planner'&&<TimePlanner/>}
{page.kind==='contact'&&<EnquiryForm/>}
{isResource&&<p class="resource-review">Introductory practice material. Transliteration is approximate. These initial resources are not yet attributed as personally reviewed by Neelam. <a href="/editorial-policy/">Read our editorial policy</a>.</p>}
</article><aside class="side-note"><p class="eyebrow">A PERSONAL STARTING POINT</p><h2>Every learner<br/>is different.</h2><p>Tell Neelam what you’d like Hindi to make possible for your family.</p><a class="button" href={enquiry}>Start a conversation <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a><p class="micro" style="margin:15px 0 0">Online from India.<br/>Fees, suitability and times confirmed before booking.</p></aside></div>
<section class="related" aria-labelledby="next"><p class="eyebrow">KEEP EXPLORING</p><h2 id="next">Your next little step.</h2><ul class="related-list">{page.related.map(slug=>{const related=findPage(slug);return related&&<li><a href={href(slug)}>{related.heading}<span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></span></a></li>})}</ul></section>
</div></Layout>
