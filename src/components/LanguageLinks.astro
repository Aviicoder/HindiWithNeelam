---
import {languageLinks} from '../data/localization';
interface Props { label?: string }
const {label='Choose language'}=Astro.props;
---
<nav class="language-links shell" aria-label={label}>
  {languageLinks.map(({path,locale,label})=><a href={path} lang={locale} hreflang={locale} aria-current={Astro.url.pathname===path?'page':undefined}>{label}</a>)}
</nav>
<style>
.language-links{display:flex;flex-wrap:wrap;gap:4px 20px;padding-block:10px;font-size:.76rem;line-height:1.5}
.language-links a{display:inline-flex;align-items:center;min-height:36px;text-underline-offset:5px}
.language-links a:hover,.language-links a[aria-current=page]{text-decoration:underline;color:var(--rust)}
@media print{.language-links{display:none}}
</style>
