<section class="tool-panel" aria-labelledby="enquiry-title"><h2 id="enquiry-title">Prepare your enquiry</h2><p class="form-hint">For a child, a parent or guardian should complete this. No payment or account needed.</p>
<form id="enquiry-form"><div class="field-grid"><div class="field"><label for="name">Your first name (optional)</label><input id="name" name="name" autocomplete="given-name" maxlength="60"/></div><div class="field"><label for="city">Your city / time zone</label><input id="city" name="city" placeholder="e.g. Melbourne or Chicago" required maxlength="100"/></div></div><div class="field"><label for="goal">What would you like to explore?</label><select id="goal" name="goal"><option>Hindi for a child</option><option>Heritage Hindi / speaking with family</option><option>Hindi for a beginner</option><option>Reading and writing</option><option>Discuss the right starting point</option></select></div><div class="field"><label for="notes">Learning goals and preferred times (optional)</label><textarea id="notes" name="notes" maxlength="1200" placeholder="An age range, current Hindi level and two possible lesson times are helpful." aria-describedby="privacy-hint"></textarea></div><p id="privacy-hint" class="form-hint">Please leave out a child’s full name, school, home address or sensitive details.</p><label class="check-field"><input type="checkbox" name="adult" required/><span>I am an adult learner or a parent/guardian making this enquiry. I understand that I choose whether to send it through WhatsApp or email.</span></label><button type="submit" class="button">Prepare my message <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></span></button></form>
<div class="enquiry-links" id="enquiry-output" hidden><p role="status" id="enquiry-status" aria-live="polite"></p><pre id="message-preview" class="message-preview"></pre><div class="actions"><a id="whatsapp-message" class="button" target="_blank" rel="noopener noreferrer">Open WhatsApp <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a><a id="email-message" class="button button-outline">Open email app <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a></div><p class="form-hint">Nothing has been sent yet. Review the message in your chosen app, then send it yourself.</p></div>
<noscript><p>The message builder needs JavaScript. You can <a class="text-link" href="mailto:learnwithneelamy@gmail.com?subject=Hindi%20lesson%20enquiry">email Neelam directly</a>.</p></noscript>
</section>
<div class="contact-options"><h2>Prefer to contact Neelam directly?</h2><p><a class="text-link" href="mailto:learnwithneelamy@gmail.com">learnwithneelamy@gmail.com</a></p><p><a class="text-link" href="https://wa.me/919971055356?text=Hello%20Neelam%2C%20I%20would%20like%20to%20enquire%20about%20Hindi%20lessons." target="_blank" rel="noopener noreferrer">WhatsApp: +91 99710 55356 <svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a></p><p class="form-hint">Messaging services have their own privacy terms. Read our <a class="text-link" href="/privacy/">privacy notice</a>.</p></div>
<script>
import {enquiryText} from '../lib/time';
const form=document.querySelector<HTMLFormElement>('#enquiry-form');const city=document.querySelector<HTMLInputElement>('#city');
const prefill=new URLSearchParams(location.search).get('city');if(city&&prefill)city.value=prefill.slice(0,100);
form?.addEventListener('submit',event=>{event.preventDefault();if(!form)return;const data=new FormData(form);const text=enquiryText({name:String(data.get('name')??'').trim(),city:String(data.get('city')??'').trim(),goal:String(data.get('goal')??''),notes:String(data.get('notes')??'').trim()});
 const output=document.querySelector<HTMLElement>('#enquiry-output'),preview=document.querySelector<HTMLElement>('#message-preview'),status=document.querySelector<HTMLElement>('#enquiry-status'),wa=document.querySelector<HTMLAnchorElement>('#whatsapp-message'),email=document.querySelector<HTMLAnchorElement>('#email-message');
 if(output&&preview&&status&&wa&&email){preview.textContent=text;wa.href='https://wa.me/919971055356?text='+encodeURIComponent(text);email.href='mailto:learnwithneelamy@gmail.com?subject=Hindi%20lesson%20enquiry&body='+encodeURIComponent(text);status.textContent='Your message is ready to review. Choose how to send it.';output.hidden=false;}
});
form?.addEventListener('input',()=>{const output=document.querySelector<HTMLElement>('#enquiry-output');if(output)output.hidden=true;});
</script>
<style>.message-preview{font:inherit;font-size:.84rem;white-space:pre-wrap;overflow-wrap:anywhere;padding:18px;background:var(--paper);border:1px solid var(--line);border-radius:5px;margin:15px 0 20px}.contact-options h2{font-size:1.6rem}.contact-options a{overflow-wrap:anywhere}</style>
