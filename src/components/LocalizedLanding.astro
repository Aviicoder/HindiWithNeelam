---
import '../styles/global.css';
import {Image} from 'astro:assets';
import portrait from '../assets/neelam-portrait.jpg';
import ContactLinks from './ContactLinks.astro';
import LanguageLinks from './LanguageLinks.astro';
import {languageLinks,type LandingCopy} from '../data/localization';
interface Props { copy:LandingCopy }
const {copy:c}=Astro.props;
const site=Astro.site;
const canonical=site?new URL(Astro.url.pathname,site).href:undefined;
const sections=['paths','teacher','resources','questions','contact'];
const resources=['/resources/hindi-vowels/','/resources/hindi-family-phrases/','/resources/five-minute-hindi/'];
const glyphs=['क','♡','आ'];
const labels={call:c.call,whatsapp:c.whatsapp,email:c.email};
const graph=[
 {'@type':'Organization','@id':site?new URL('/#organization',site).href:'/#organization',name:'Hindi with Neelam',email:'learnwithneelamy@gmail.com',telephone:'+919971055356'},
 {'@type':'WebPage',name:c.title,description:c.description,inLanguage:c.locale,...(canonical?{url:canonical}:{})},
];
---
<!doctype html>
<html lang={c.locale}>
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{c.title}</title><meta name="description" content={c.description}/>
 <meta name="robots" content={site?'index, follow':'noindex, nofollow'}/>
 {canonical&&<link rel="canonical" href={canonical}/>}
 {site&&languageLinks.map(link=><link rel="alternate" hreflang={link.locale} href={new URL(link.path,site).href}/>)}
 {site&&<link rel="alternate" hreflang="x-default" href={new URL('/',site).href}/>}
 <meta property="og:type" content="website"/><meta property="og:title" content={c.title}/><meta property="og:description" content={c.description}/><meta property="og:site_name" content="Hindi with Neelam"/>
 <meta property="og:locale" content={c.locale.replace('-','_')}/>
 {canonical&&<meta property="og:url" content={canonical}/>}
 {site&&<meta property="og:image" content={new URL('/images/neelam-portrait.jpg',site).href}/>}
 <meta name="twitter:card" content="summary"/><meta name="theme-color" content="#fcf8ef"/>
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
</head>
<body>
 <a class="skip-link" href="#main">{c.skip}</a>
 <div class="announcement">{c.announcement} <span>{c.online}</span></div>
 <header class="site-header"><div class="shell header-inner">
  <a class="brand" href={Astro.url.pathname} aria-label={c.home}><span class="brand-mark" lang="hi">अ</span><span>hindi<span class="brand-small">with Neelam</span></span></a>
  <nav class="desktop-nav" aria-label={c.navigation}>{sections.map((id,i)=><a href={'#'+id}>{c.nav[i]}</a>)}</nav>
  <a class="button button-small header-cta" href="#contact">{c.enquire}</a>
  <details class="mobile-nav"><summary>{c.menu} <span aria-hidden="true">☰</span></summary><nav aria-label={c.navigation}>{sections.map((id,i)=><a href={'#'+id}>{c.nav[i]}</a>)}</nav></details>
 </div></header>
 <div class="contact-strip"><div class="shell"><ContactLinks compact labels={labels} message={c.message}/></div></div>
 <LanguageLinks label={c.languages}/>
 <main id="main">
  <section class="hero"><div class="shell hero-grid"><div class="hero-copy">
   <p class="eyebrow">{c.eyebrow}</p><h1>{c.hero[0]}<br/>{c.hero[1]}<br/><em>{c.hero[2]}</em></h1>
   <p class="intro">{c.intro}</p><div class="actions"><a class="button" href="#contact">{c.enquire}</a><a class="text-link" href="#teacher">{c.meet}</a></div>
   <ContactLinks labels={labels} message={c.message}/><p class="hero-note">{c.note}</p>
  </div><div class="hero-art"><div class="portrait-frame">
   <Image src={portrait} alt={c.portrait} widths={[420,640,900]} sizes="(max-width: 760px) 90vw, 40vw" width={900} height={1200} format="webp" loading="eager" fetchpriority="high"/>
   <div class="portrait-label"><div><strong>{c.meet}</strong><span>{c.portraitLabel}</span></div><a href="#teacher" aria-label={c.meet}><svg class="arrow-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a></div>
  </div><div class="hello-stamp"><b lang="hi">नमस्ते</b><small>{c.hello}</small></div></div></div></section>
  <div class="feature-strip"><div class="shell strip-inner">{c.features.map(text=><span>{text}</span>)}</div></div>
  <section class="section" id="paths"><div class="shell"><div class="section-heading"><div><p class="eyebrow">{c.pathsEyebrow}</p><h2>{c.pathsHeading[0]} <em>{c.pathsHeading[1]}</em></h2></div><p>{c.pathsIntro}</p></div>
   <div class="cards">{c.paths.map((path,i)=><article class="path-card"><span class="card-number">{path[0]}</span><span class="card-glyph" lang={i===1?undefined:'hi'} aria-hidden="true">{glyphs[i]}</span><h3>{path[1]}</h3><p>{path[2]}</p><a class="text-link" href="#contact">{path[3]}</a></article>)}</div>
  </div></section>
  <section class="section warm-section" id="teacher"><div class="shell teacher-section"><div class="teacher-photo"><Image src={portrait} alt={c.portrait} width={600} height={800} format="webp" loading="lazy"/><div class="teacher-caption">{c.teacherCaption}</div></div><div class="teacher-copy">
   <p class="eyebrow">{c.teacherEyebrow}</p><h2>{c.teacherHeading[0]}<br/>{c.teacherHeading[1]}<br/><em>{c.teacherHeading[2]}</em></h2>{c.teacherBody.map(text=><p>{text}</p>)}<p class="micro">{c.qualifications}</p><a class="text-link" href="#contact">{c.enquire}</a>
  </div></div></section>
  <section class="section" id="resources"><div class="shell"><div class="section-heading"><div><p class="eyebrow">{c.resourcesEyebrow}</p><h2>{c.resourcesHeading[0]} <em>{c.resourcesHeading[1]}</em></h2></div><p>{c.resourcesIntro}</p></div>
   <div class="resource-grid">{c.resources.map((resource,i)=><a class="resource-card" href={resources[i]} hreflang="en"><div class="resource-art" lang="hi" aria-hidden="true">{['अ आ इ','नमस्ते','५'][i]}</div><div class="resource-body"><p class="eyebrow">{resource[0]}</p><h3>{resource[1]}</h3><p>{resource[2]}</p><span class="text-link">{resource[3]}</span></div></a>)}</div>
   <div class="actions resource-download"><a class="button button-outline" href="/resources/hindi-vowel-practice.pdf" download>{c.download}</a></div><p class="resource-review">{c.resourceNote}</p>
  </div></section>
  <section class="section warm-section" id="questions"><div class="shell faq-grid"><div><p class="eyebrow">{c.faqEyebrow}</p><h2>{c.faqHeading[0]}<br/><em>{c.faqHeading[1]}</em></h2><a class="text-link" href="#contact">{c.enquire}</a></div><div class="faq-list">{c.faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
 </main>
 <section class="closing-cta" id="contact"><div class="shell closing-inner"><div><p class="eyebrow">{c.contactEyebrow}</p><h2>{c.contactHeading[0]}<br/><em>{c.contactHeading[1]}</em></h2></div><div><p>{c.contactBody}</p><ContactLinks labels={labels} message={c.message}/><p>{c.contactNote}</p><p class="micro">{c.terms}</p></div></div></section>
 <footer class="footer"><div class="shell localized-footer"><div><a class="brand" href={Astro.url.pathname} aria-label={c.home}><span class="brand-mark" lang="hi">अ</span><span>hindi<span class="brand-small">with Neelam</span></span></a><p>{c.footer}</p><p class="micro">{c.online}</p></div><div><h2>{c.nav[0]}</h2>{c.paths.map(path=><a href="#contact">{path[3]}</a>)}</div><div><h2>{c.english}</h2>{c.resources.map((r,i)=><a href={resources[i]} hreflang="en">{r[3]}</a>)}</div></div>
  <div class="shell"><ContactLinks labels={labels} message={c.message}/></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Hindi with Neelam</span><div><a href="/privacy/" hreflang="en">{c.privacy}</a><a href="/accessibility/" hreflang="en">{c.accessibility}</a><a href="/editorial-policy/" hreflang="en">{c.editorial}</a></div></div>
 </footer>
</body>
</html>
<style>
.contact-strip{border-block:1px solid var(--line);background:var(--sage)}.contact-strip>.shell{padding-block:4px}
.hero-copy h1{font-size:clamp(2.5rem,4.5vw,4.7rem);overflow-wrap:anywhere}
.header-inner{gap:20px}.desktop-nav{gap:18px}.header-cta{max-width:210px}
.hello-stamp small{padding-inline:8px;line-height:1.3}.portrait-label>div{min-width:0}.portrait-label strong{overflow-wrap:anywhere}
.section-heading h2,.teacher-copy h2,.closing-cta h2{overflow-wrap:anywhere}
.closing-inner>div{min-width:0;flex:1}.teacher-caption{max-width:90%;font-size:1rem}
.resource-download{margin-top:24px}.localized-footer{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:40px}
.localized-footer h2{font-family:var(--sans);font-size:.9rem;font-weight:600}.localized-footer p{margin-top:20px}.localized-footer>div>a:not(.brand){display:block;font-size:.8rem;margin:12px 0;color:var(--muted)}
@media(max-width:1050px){.desktop-nav{gap:12px;font-size:.75rem}}
@media(max-width:760px){.hero-copy h1{font-size:clamp(2.2rem,8.5vw,3.7rem)}.localized-footer{grid-template-columns:1fr;gap:28px}.teacher-caption{font-size:.9rem}.footer-bottom>div{flex-wrap:wrap}.header-inner{gap:12px}}
</style>
